{
  "name": "tailwind-cv",
  "private": false,
  "version": "1.0.0",
  "description": "Open-source, zero-dependency CV builder powered by Tailwind CSS v4 and Vite. Design, edit, and export A4 PDFs in the browser.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwaldheim/tailwind-cv.git"
  },
  "homepage": "https://github.com/mwaldheim/tailwind-cv",
  "author": "Markus Waldheim",
  "license": "MIT",
  "keywords": ["cv", "resume", "tailwindcss", "vite", "pdf", "builder", "open-source"],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
